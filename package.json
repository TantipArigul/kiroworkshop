{
  "name": "smart-checkup-package-recommendation-portal",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.8.1"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm --filter @portal/api test:unit",
    "test:integration": "pnpm --filter @portal/api test:integration",
    "test:properties": "pnpm --filter @portal/api test:properties",
    "validate:tokens": "node .kiro/skills/design-system/scripts/validate-tokens.cjs --dir apps/web/src"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
