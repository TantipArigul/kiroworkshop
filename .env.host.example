# Host-run mode (wf-renamefastq available). `scripts/setup-nextflow.sh` writes .env.host for you;
# this template documents the keys it sets. Copy every other key from your .env, keep it private
# (chmod 600) and never commit it. All paths are absolute paths on this machine.
NODE_ENV=production
PORT=3000
# Same database file Docker Compose uses: <ENCRYPTED_DATA_ROOT>/portal.db
DATABASE_URL=file:/absolute/path/to/compose-data/portal.db
# Copy from .env (never commit the real value).
SESSION_SECRET=
ALLOWED_ORIGINS=https://localhost
# One narrow parent folder for job files and Nextflow assets; Docker must be able to share it.
STORAGE_ROOT=/absolute/path/to/portal-data/storage
NEXTFLOW_ENABLED=true
NEXTFLOW_HOME=/absolute/path/to/portal-data/nxf-home
# Absolute paths from `command -v nextflow` and `command -v docker`.
NEXTFLOW_BIN=/opt/homebrew/bin/nextflow
DOCKER_BIN=/usr/local/bin/docker
NEXTFLOW_MAX_CONCURRENT_RUNS=1
