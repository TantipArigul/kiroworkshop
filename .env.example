NODE_ENV=development
PORT=3000
DATABASE_URL=file:./data/portal.db
SESSION_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=https://localhost
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=30000
STORAGE_ROOT=/var/lib/portal-private
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100
LOGIN_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_MAX=120
SUBMIT_RATE_LIMIT_MAX=10
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_DURATION_MINUTES=15
AUDIT_RETENTION_DAYS=90
EXECUTOR_ENABLED=true
EXECUTOR_POLL_INTERVAL_MS=2000
EXECUTOR_QUEUED_DELAY_MS=3000
EXECUTOR_RUNNING_DELAY_MS=5000
JOB_RETENTION_DAYS=7
RETENTION_SWEEP_INTERVAL_MS=3600000
# Pipeline Catalog & Nextflow executor (host only; keep false in Compose/CI).
# STORAGE_ROOT must be under a path Docker Desktop shares (e.g. /Users/<user>/...).
NEXTFLOW_ENABLED=false
# Executables resolved from PATH unless absolute.
NEXTFLOW_BIN=nextflow
DOCKER_BIN=docker
# Optional absolute NXF_HOME (assets, plugins); empty = Nextflow default (~/.nextflow).
NEXTFLOW_HOME=
# Concurrent Nextflow runs (1-4).
NEXTFLOW_MAX_CONCURRENT_RUNS=1
# Per-run caps passed as max_cpus (1-16), max_memory GB (2-64) and max_time hours (1-48).
NEXTFLOW_MAX_CPUS=4
NEXTFLOW_MAX_MEMORY_GB=8
NEXTFLOW_MAX_TIME_HOURS=8
# Wait after SIGTERM before SIGKILL on cancel (1000-120000 ms).
NEXTFLOW_CANCEL_GRACE_MS=30000
# How often pipeline readiness is re-checked (10000-600000 ms).
NEXTFLOW_READINESS_INTERVAL_MS=60000
