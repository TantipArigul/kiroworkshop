# Training server runtime config (deployment.md). Copy to /etc/portal/portal.env:
#   sudo install -m 600 -o root -g root .env.production.example /etc/portal/portal.env
# Then set SESSION_SECRET and ALLOWED_ORIGINS. Never commit the real file.
NODE_ENV=production
PORT=3000
# Paths inside the API container; the host path is ENCRYPTED_DATA_ROOT (LUKS volume) in /etc/portal/deploy.env.
DATABASE_URL=file:/var/lib/portal-private/portal.db
STORAGE_ROOT=/var/lib/portal-private
# Secret: generate with `openssl rand -hex 48`. Rotate every 90 days or on suspicion (signs out every user).
SESSION_SECRET=
# Exact HTTPS origin of the server, e.g. https://portal.example.internal
ALLOWED_ORIGINS=
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=30000
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100
LOGIN_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_MAX=120
SUBMIT_RATE_LIMIT_MAX=10
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_DURATION_MINUTES=15
AUDIT_RETENTION_DAYS=90
EXECUTOR_ENABLED=true
EXECUTOR_POLL_INTERVAL_MS=2000
EXECUTOR_QUEUED_DELAY_MS=3000
EXECUTOR_RUNNING_DELAY_MS=5000
JOB_RETENTION_DAYS=7
RETENTION_SWEEP_INTERVAL_MS=3600000
# Nextflow is not available in Compose (no Docker socket): wf-renamefastq shows as unavailable.
NEXTFLOW_ENABLED=false
