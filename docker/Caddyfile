{$DOMAIN:localhost} {
	tls internal

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	handle /health* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	# SPA: everything else is a static file, falling back to index.html for client-side routes.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
